{
  "name": "@ai-zen/pdf-parse-mcp",
  "version": "0.1.0",
  "description": "MCP server (stdio) that extracts precise text and vector-graphics geometry from PDFs and renders pages to images — built to help agents reconstruct designs from PDF files.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "pdf-parse-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rimraf ./dist",
    "prebuild": "npm run clean",
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node scripts/smoke.mjs && node scripts/mcp-smoke.mjs",
    "overlay": "node scripts/overlay.mjs",
    "prepublishOnly": "npm run test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "pdf",
    "pdfjs",
    "extract",
    "text",
    "vector",
    "graphics",
    "coordinates",
    "render",
    "design",
    "agent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ai-zen/pdf-parse-mcp.git"
  },
  "homepage": "https://github.com/ai-zen/pdf-parse-mcp#readme",
  "bugs": {
    "url": "https://github.com/ai-zen/pdf-parse-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@napi-rs/canvas": "^1.0.9",
    "pdfjs-dist": "^6.3.289",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
